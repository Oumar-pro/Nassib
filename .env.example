# Frontend Supabase configuration. Vite exposes VITE_* variables to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase configuration. Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Imam Oumar AI service.
GEMINI_API_KEY=
